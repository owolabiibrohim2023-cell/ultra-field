# Frontend-safe configuration only.
# Never store secret keys or backend credentials in frontend environment variables.
# This base URL points at the future FastAPI backend (to be built in a later phase).
VITE_API_BASE_URL=http://localhost:8000/api

# Paystack PUBLISHABLE (public) key — safe for the frontend.
# Used only to open the inline checkout. The SECRET key must never be placed here;
# it lives on the backend and is used to verify transactions (verify/webhook).
# When unset, the payment page falls back to a clearly-labelled demo mode.
VITE_PAYSTACK_PUBLIC_KEY=
